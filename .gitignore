# Dependencies
node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example

# Uploaded match documents and media
uploads/*
!uploads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime files
pids/
*.pid
*.pid.lock

# Coverage and test output
coverage/
.nyc_output/

# Build and cache directories
dist/
build/
.cache/
.tmp/
temp/

# Editor settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Optional local database files
*.sqlite
*.sqlite3
*.db

# Optional local JSON data snapshots
data/*.local.json

# KHL scouting SPA (server/ + client/)
# Патерны выше со слэшем внутри привязаны к корню репозитория, поэтому
# подкаталоги перечислены отдельно.
server/.env
server/uploads/*
!server/uploads/.gitkeep
client/node_modules/
client/dist/
