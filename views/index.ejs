<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <main class="container">
    <header class="page-header">
      <div>
        <h1>Протокол</h1>
        <p>Учебный журнал хоккейных матчей</p>
      </div>

      <a class="button" href="/matches/new">Добавить матч</a>
    </header>

    <form method="GET" action="/" class="filter-form">
      <label for="status">Статус:</label>

      <select id="status" name="status">
        <option value="Все" <%= selectedStatus === 'Все' ? 'selected' : '' %>>
          Все матчи
        </option>

        <option value="Ожидается"
          <%= selectedStatus === 'Ожидается' ? 'selected' : '' %>>
          Ожидается
        </option>

        <option value="Подготовка к матчу"
          <%= selectedStatus === 'Подготовка к матчу' ? 'selected' : '' %>>
          Подготовка к матчу
        </option>

        <option value="Идёт 1-ый период"
          <%= selectedStatus === 'Идёт 1-ый период' ? 'selected' : '' %>>
          Идёт 1-ый период
        </option>

        <option value="Первый перерыв"
          <%= selectedStatus === 'Первый перерыв' ? 'selected' : '' %>>
          Первый перерыв
        </option>

        <option value="Идёт 2-ой период"
          <%= selectedStatus === 'Идёт 2-ой период' ? 'selected' : '' %>>
          Идёт 2-ой период
        </option>

        <option value="Второй перерыв"
          <%= selectedStatus === 'Второй перерыв' ? 'selected' : '' %>>
          Второй перерыв
        </option>

        <option value="Идёт 3-й период"
          <%= selectedStatus === 'Идёт 3-й период' ? 'selected' : '' %>>
          Идёт 3-й период
        </option>

        <option value="Завершён"
          <%= selectedStatus === 'Завершён' ? 'selected' : '' %>>
          Завершён
        </option>

        <option value="Овертайм"
          <%= selectedStatus === 'Овертайм' ? 'selected' : '' %>>
          Овертайм
        </option>

        <option value="Буллиты"
          <%= selectedStatus === 'Буллиты' ? 'selected' : '' %>>
          Буллиты
        </option>

        <option value="Отменён"
          <%= selectedStatus === 'Отменён' ? 'selected' : '' %>>
          Отменён
        </option>

      </select>

      <button type="submit">Показать</button>
      <a class="text-link" href="/">Сбросить фильтр</a>
    </form>

    <% if (matches.length === 0) { %>
      <p class="empty-message">Матчи с таким статусом не найдены.</p>
    <% } %>

    <section class="matches-grid">
      <% matches.forEach((match) => { %>
        <article class="match-card">
          <div class="match-card__top">
            <span class="status"><%= match.status %></span>
            <a href="/matches/<%= match.id %>/edit">Изменить</a>
          </div>

          <h2 class="teams-line">
            <span class="team-name"><%= match.homeTeam.shortName %></span>
            <span class="versus">—</span>
            <span class="team-name"><%= match.awayTeam.shortName %></span>
          </h2>

          <p class="score">
            <%= match.homeGoals === null || match.awayGoals === null
              ? '— : —'
              : `${match.homeGoals} : ${match.awayGoals}` %>
          </p>

          <dl class="match-details">
            <div>
              <dt>Дата и время</dt>
              <dd>
                <%= new Date(match.dateTime).toLocaleString('ru-RU', {
                  day: '2-digit',
                  month: 'long',
                  year: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit'
                }) %>
              </dd>
            </div>

            <div>
              <dt>Арена</dt>
              <dd><%= match.venue.name %>, <%= match.venue.city %></dd>
            </div>
          </dl>

          <% if (match.attachment) { %>
            <p class="attachment">
              Файл:
              <a href="/uploads/<%= match.attachment %>" target="_blank">
                открыть прикреплённый протокол
              </a>
            </p>
          <% } else { %>
            <p class="attachment attachment--empty">
              Файл протокола пока не прикреплён
            </p>
          <% } %>
        </article>
      <% }) %>
    </section>
  </main>
</body>
</html>