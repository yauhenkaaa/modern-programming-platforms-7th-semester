<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <main class="container">
    <a class="text-link" href="/">← Вернуться к матчам</a>

    <h1>Редактирование матча</h1>

    <section class="edit-match-info">
      <h2>
        <%= match.homeTeam.name %>
        —
        <%= match.awayTeam.name %>
      </h2>

      <p>
        Арена: <%= match.venue.name %>,
        <%= match.venue.city %>
      </p>

      <p>
        Дата: <%= new Date(match.dateTime).toLocaleString('ru-RU') %>
      </p>
    </section>

    <form
      method="POST"
      action="/matches/<%= match.id %>/update"
      class="match-form"
    >
      <label for="status">Статус матча</label>

      <select id="status" name="status" required>
        <option
          value="Ожидается"
          <%= match.status === 'Ожидается' ? 'selected' : '' %>
        >
          Ожидается
        </option>

        <option
          value="Подготовка к матчу"
          <%= match.status === 'Подготовка к матчу' ? 'selected' : '' %>
        >
          Подготовка к матчу
        </option>

        <option
          value="Идёт 1-ый период"
          <%= match.status === 'Идёт 1-ый период' ? 'selected' : '' %>
        >
          Идёт 1-ый период
        </option>

        <option
          value="Первый перерыв"
          <%= match.status === 'Первый перерыв' ? 'selected' : '' %>
        >
          Первый перерыв
        </option>

        <option
          value="Идёт 2-ой период"
          <%= match.status === 'Идёт 2-ой период' ? 'selected' : '' %>
        >
          Идёт 2-ой период
        </option>

        <option
          value="Второй перерыв"
          <%= match.status === 'Второй перерыв' ? 'selected' : '' %>
        >
          Второй перерыв
        </option>

        <option
          value="Идёт 3-ий период"
          <%= match.status === 'Идёт 3-ий период' ? 'selected' : '' %>
        >
          Идёт 3-ий период
        </option>

        <option
          value="Овертайм"
          <%= match.status === 'Овертайм' ? 'selected' : '' %>
        >
          Овертайм
        </option>

        <option
          value="Буллиты"
          <%= match.status === 'Буллиты' ? 'selected' : '' %>
        >
          Буллиты
        </option>

        <option
          value="Завершён"
          <%= match.status === 'Завершён' ? 'selected' : '' %>
        >
          Завершён
        </option>

        <option
          value="Отменён"
          <%= match.status === 'Отменён' ? 'selected' : '' %>
        >
          Отменён
        </option>
      </select>

      <label for="homeGoals">
        Голы команды «<%= match.homeTeam.shortName %>»
      </label>

      <input
        id="homeGoals"
        name="homeGoals"
        type="number"
        min="0"
        step="1"
        value="<%= match.homeGoals === null ? '' : match.homeGoals %>"
      >

      <label for="awayGoals">
        Голы команды «<%= match.awayTeam.shortName %>»
      </label>

      <input
        id="awayGoals"
        name="awayGoals"
        type="number"
        min="0"
        step="1"
        value="<%= match.awayGoals === null ? '' : match.awayGoals %>"
      >

      <button type="submit">Сохранить изменения</button>
    </form>

    <form
      method="POST"
      action="/matches/<%= match.id %>/attachment"
      enctype="multipart/form-data"
      class="match-form attachment-form"
    >
      <label for="attachment">Добавить или заменить файл протокола</label>

      <input
        id="attachment"
        name="attachment"
        type="file"
        accept=".pdf,.jpg,.jpeg,.png,.txt"
        required
      >

      <button type="submit">Загрузить файл</button>
    </form>
  </main>
</body>
</html>